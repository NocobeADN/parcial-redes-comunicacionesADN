# =====================================================================
#  Parcial 2 - Comunicaciones (Ingeniería Mecatrónica)
#  Variables por defecto. Uso:  cp .env.example .env && docker compose up -d
#  (docker-compose.yml también trae estos mismos valores como respaldo,
#   de modo que el despliegue funciona incluso si .env no existe)
# =====================================================================

# ---------- Zona horaria de todos los contenedores ----------
TZ=America/Bogota

# ---------- Puerto publicado en el host (único puerto expuesto) ----------
HTTP_PORT=80

# ---------- PostgreSQL (superusuario administrador del motor) ----------
POSTGRES_DB=joomla
POSTGRES_USER=dba_admin
POSTGRES_PASSWORD=PgAdmin_Parcial2026

# ---------- Rol de aplicación que usa Joomla (dueño del esquema public) ----------
JOOMLA_DB_USER=joomla_app
JOOMLA_DB_PASSWORD=JoomlaApp_Parcial2026
JOOMLA_DB_PREFIX=jos_

# ---------- Roles de solo lectura (principio de mínimo privilegio) ----------
# Usado por el datasource aprovisionado de Grafana
GRAFANA_DB_USER=grafana_reader
GRAFANA_DB_PASSWORD=GrafanaReader_2026
# Usado por el cuaderno de Jupyter
ANALISTA_DB_USER=analista
ANALISTA_DB_PASSWORD=Analista_Parcial2026

# ---------- Instalación desatendida de Joomla ----------
JOOMLA_SITE_NAME=Portal Academico e Industrial - Parcial Comunicaciones
JOOMLA_ADMIN_USER=Administrador del Portal
# Solo letras (restricción de la imagen oficial)
JOOMLA_ADMIN_USERNAME=admin
# Debe tener MÁS de 12 caracteres (restricción de la imagen oficial)
JOOMLA_ADMIN_PASSWORD=AdminJoomla_2026
JOOMLA_ADMIN_EMAIL=admin@parcial.local

# ---------- Grafana ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=AdminGrafana_2026

# ---------- Jupyter ----------
# Token de acceso a JupyterLab (http://localhost/jupyter/?token=<valor>)
JUPYTER_TOKEN=parcial2026

# ---------- Direccionamiento de las redes bridge (Capa 3) ----------
# Se eligió un rango 10.201.x.x, fuera de los pools automáticos de Docker
# (172.17-31.x.x / 192.168.x.x), para evitar solapamientos.
# Cámbielas solo si chocan con redes ya existentes en su máquina.
FRONTEND_SUBNET=10.201.10.0/24
BACKEND_SUBNET=10.201.20.0/24
