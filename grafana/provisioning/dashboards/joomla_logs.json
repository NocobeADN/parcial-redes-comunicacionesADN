{
  "uid": "parcial-joomla-logs",
  "title": "Parcial Comunicaciones - Tráfico Joomla y PostgreSQL",
  "description": "Tráfico HTTP (Nginx/Apache) y actividad del CMS, leídos desde PostgreSQL (file_fdw).",
  "tags": [
    "parcial",
    "nginx",
    "joomla",
    "postgresql",
    "osi"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "servicio",
