          "rawSql": "SELECT count(DISTINCT ip_origen) AS \"IPs\" FROM monitoreo.v_nginx_accesos WHERE $__timeFilter(ts) AND servicio IN ($servicio)"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Latencia p95",
      "description": "Percentil 95 de $request_time (desde el primer byte del cliente hasta el último byte enviado).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-parcial"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-parcial"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(percentile_cont(0.95) WITHIN GROUP (ORDER BY tiempo_total_s), 0) AS \"p95\" FROM monitoreo.v_nginx_accesos WHERE $__timeFilter(ts) AND servicio IN ($servicio)"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Reuso keep-alive",
      "description": "Capa 4: % de peticiones proxificadas cuyo $upstream_connect_time fue 0, es decir, que reutilizaron una conexión TCP ya abierta del pool keepalive (sin three-way handshake).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pg-parcial"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "teal",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pg-parcial"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(100.0 * count(*) FILTER (WHERE upstream_connect_s = 0) / NULLIF(count(*) FILTER (WHERE upstream_connect_s IS NOT NULL), 0), 0) AS \"Reutilización\" FROM monitoreo.v_nginx_accesos WHERE $__timeFilter(ts) AND servicio IN ($servicio)"
        }
      ]
    },
