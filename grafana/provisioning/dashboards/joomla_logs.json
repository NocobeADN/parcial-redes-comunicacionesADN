        "current": {
          "selected": true,
          "text": [
            "joomla"
          ],
          "value": [
            "joomla"
          ]
        },
        "options": [
          {
            "selected": true,
            "text": "joomla",
            "value": "joomla"
          },
          {
            "selected": false,
            "text": "jupyter",
            "value": "jupyter"
          },
          {
            "selected": false,
            "text": "grafana",
            "value": "grafana"
          }
        ],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Portal Joomla",
      "type": "link",
      "url": "/",
      "targetBlank": true,
      "icon": "external link"
    },
    {
      "title": "JupyterLab",
      "type": "link",
      "url": "/jupyter/",
      "targetBlank": true,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Resumen del tráfico HTTP (log de acceso de Nginx)",
